{
  "name": "mapcairn",
  "version": "1.0.0",
  "description": "Reusable SDK for public-interest geospatial layer platforms",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mapcairn/web",
    "start": "npm run start -w @mapcairn/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check --error-on-warnings . && npm run depcruise && npm run lint:harmony",
    "depcruise": "node scripts/depcruise.mjs",
    "lint:harmony": "node scripts/harmony/cli.mjs --ignore-legacy",
    "format": "biome format --write .",
    "prepare": "lefthook install --force",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run e2e -w @mapcairn/web",
    "test:e2e": "npm run test:e2e -w @mapcairn/web",
    "a11y": "npm run a11y -w @mapcairn/web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e && npm run a11y"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@swc/core": "1.16.22",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "workerd": true,
    "@swc/core": false
  }
}
