{
  "name": "karta",
  "version": "1.0.0",
  "description": "Reusable SDK for public-interest geospatial layer platforms",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings . && npm run depcruise",
    "depcruise": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "format": "biome format --write .",
    "prepare": "lefthook install --force",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @karta/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@inlang/plugin-message-format": "4.6.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "workerd": true
  }
}
