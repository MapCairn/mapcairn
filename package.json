{
  "name": "mapcairn",
  "version": "1.0.0",
  "description": "Reusable SDK for public-interest geospatial layer platforms",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mapcairn/web",
    "start": "npm run start -w @mapcairn/web",
    "deploy": "npm run deploy -w @mapcairn/web",
    "deploy:preview": "npm run deploy:preview -w @mapcairn/web",
    "build:sdk": "node scripts/buildSdk.mjs",
    "build": "npm run build:sdk && npm run build -w @mapcairn/web && npm run build -w @mapcairn/example-embed",
    "lint": "biome check --error-on-warnings . && npm run depcruise && npm run lint:harmony && npm run licence && npm run licence:sdk && npm run agents:check && npm run roadmap:check && npm run names:check && npm run portability:check",
    "depcruise": "node scripts/depcruise.mjs",
    "lint:harmony": "node scripts/harmony/cli.mjs",
    "licence": "node scripts/licenceHeaders.mjs",
    "licence:write": "node scripts/licenceHeaders.mjs --write",
    "licence:sdk": "node scripts/sdkLicences.mjs",
    "agents:sync": "node scripts/agents/sync.mjs",
    "agents:check": "node scripts/agents/sync.mjs --check",
    "roadmap:check": "node scripts/roadmap-check.mjs",
    "names:check": "node scripts/names-check.mjs files",
    "portability:check": "node scripts/portability-check.mjs",
    "port": "node scripts/agents/port.mjs",
    "catalogue:check": "npm run catalogue:check -w @mapcairn/web --",
    "format": "biome format --write .",
    "prepare": "lefthook install --force",
    "typecheck": "npm run build:sdk && npm run typecheck --workspaces --if-present",
    "test": "npm run build:sdk && vitest run",
    "test:coverage": "npm run build:sdk && vitest run --coverage",
    "e2e": "npm run e2e -w @mapcairn/web",
    "test:e2e": "npm run test:e2e -w @mapcairn/web",
    "a11y": "npm run a11y -w @mapcairn/web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e && npm run a11y"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@microsoft/api-extractor": "^7.60.1",
    "@swc/core": "^1.16.22",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "lefthook": "^2.2.2",
    "modern-web-guidance": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "workerd": true,
    "@swc/core": false
  }
}
