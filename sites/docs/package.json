{
  "name": "@mapcairn/docs",
  "version": "1.0.0",
  "description": "MapCairn documentation site: Docusaurus, built to static files and served at /docs/ by a second Worker",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "generate": "node --import tsx scripts/generateTheme.ts",
    "deploy": "cf deploy ./build",
    "dev": "npm run generate && docusaurus start --port 4410",
    "build": "npm --prefix ../.. run build:sdk && npm run generate && docusaurus build && node --import tsx scripts/verifyBuild.ts",
    "typecheck": "npm --prefix ../.. run build:sdk && tsc --noEmit",
    "test": "npm --prefix ../.. run build:sdk && vitest run"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@mapcairn/core": "0.1.0",
    "@mapcairn/theme": "0.1.0",
    "@mdx-js/react": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "cf": "1.0.0-beta.32",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
