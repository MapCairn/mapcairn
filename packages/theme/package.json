{
  "name": "@mapcairn/theme",
  "version": "0.0.0",
  "description": "Typed vanilla-extract contract for MapCairn's design tokens",
  "license": "AGPL-3.0-only",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@mapcairn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "files": [
    "dist",
    "!dist/.built"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/buildPackage.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/integration": "^8.0.11",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
