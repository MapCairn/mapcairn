{
  "id": "sample-heat",
  "name": "Sample density",
  "description": "How dense the points of a sample feed are.",
  "group": "Samples",
  "dataCost": "about 40 KB",
  "attribution": [
    {
      "text": "Sample density provider"
    }
  ],
  "controls": [
    {
      "kind": "range",
      "id": "radius",
      "label": "Radius",
      "min": 4,
      "max": 80,
      "step": 2,
      "default": 20,
      "unit": " px"
    },
    {
      "kind": "range",
      "id": "intensity",
      "label": "Intensity",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "default": 1
    },
    {
      "kind": "opacity",
      "id": "opacity",
      "label": "Opacity",
      "default": 0.8
    }
  ],
  "source": {
    "kind": "feed",
    "url": "https://heat.test/points.json",
    "decoder": "geojson",
    "fields": {
      "id": "id",
      "title": "properties.name",
      "weight": "properties.weight"
    }
  },
  "heatmap": {
    "weightField": "weight",
    "radius": {
      "control": "radius"
    },
    "intensity": {
      "control": "intensity"
    },
    "ramp": ["ordinal-1", "ordinal-3", "ordinal-5"],
    "words": ["Sparse", "Moderate", "Dense"]
  },
  "emptyText": "No sample points."
}
