{
  "id": "sample-rain",
  "name": "Sample rain",
  "description": "Half-hourly sample rain, about six hours behind.",
  "group": "Imagery",
  "attribution": [
    {
      "text": "Sample rain provider"
    }
  ],
  "controls": [
    {
      "kind": "datetime",
      "id": "time",
      "label": "Time shown",
      "description": "Some half hours have no data.",
      "stepMinutes": 30,
      "min": "2000-06-01t0000",
      "max": {
        "minutesAgo": 360
      },
      "default": {
        "minutesAgo": 360
      }
    },
    {
      "kind": "opacity",
      "id": "opacity",
      "label": "Opacity",
      "default": 0.8
    }
  ],
  "source": {
    "kind": "tiles",
    "tiles": "https://tiles.test/rain/{time}/{z}/{y}/{x}.png",
    "tileSize": 256,
    "maxzoom": 6
  }
}
