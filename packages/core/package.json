{
  "name": "@mapcairn/core",
  "version": "0.0.0",
  "description": "Domain-agnostic ports, pure logic and basemap definitions for MapCairn",
  "license": "AGPL-3.0-only",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@mapcairn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "@mapcairn/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "!dist/.built"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/buildPackage.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@types/geojson": "^7946.0.16"
  },
  "peerDependencies": {
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
