{
  "name": "@mapcairn/geolint",
  "version": "0.0.0",
  "description": "A linter for GeoJSON: the mistakes people make beyond schema validation, as a command and a library",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "geolint": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "build:countries": "node scripts/build-countries.mjs",
    "bench": "node bench/run.mjs",
    "bench:rules": "node bench/rules.mjs"
  },
  "dependencies": {
    "flatbush": "4.7.0",
    "robust-predicates": "3.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "tinybench": "6.2.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
