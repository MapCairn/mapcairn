{
  "name": "@mapcairn/map",
  "version": "0.0.0",
  "description": "Generic map rendering and UI components for MapCairn",
  "license": "AGPL-3.0-only",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@mapcairn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "!dist/.built"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "scripts": {
    "build": "node ../../scripts/buildPackage.mjs",
    "test": "vitest run",
    "typecheck": "npm --prefix ../.. run build:sdk && tsc --noEmit"
  },
  "dependencies": {
    "@mapcairn/core": "^0.0.0",
    "@mapcairn/react": "^0.0.0",
    "@mapcairn/theme": "^0.0.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "lucide-react": "^1.72.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
