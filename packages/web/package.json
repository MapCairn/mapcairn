{
  "name": "@mapcairn/web",
  "version": "1.0.0",
  "description": "MapCairn web SPA map viewer",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/verifyNoTestSeam.mjs",
    "build:e2e": "react-router build --mode e2e && node scripts/verifyNoTestSeam.mjs --expect-present",
    "start": "node scripts/startE2e.mjs",
    "typecheck": "react-router typegen && tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.playwright.json --noEmit",
    "preview:e2e": "wrangler dev --config ../../wrangler.e2e.jsonc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e": "playwright test --grep-invert @a11y",
    "a11y": "playwright test --grep @a11y",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium webkit",
    "generate:og-image": "tsx scripts/generateOgImage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.2.1",
    "fontaine": "1.0.3",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@mapcairn/core": "file:../core",
    "@mapcairn/map": "file:../map",
    "@mapcairn/react": "file:../react",
    "@mapcairn/theme": "file:../theme",
    "@vanilla-extract/css": "1.21.3",
    "lucide-react": "1.70.0",
    "maplibre-gl": "6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  }
}
