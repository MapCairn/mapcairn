{
  "name": "@mapcairn/web",
  "version": "1.0.0",
  "description": "MapCairn reference host: server-rendered map site on Cloudflare Workers",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../.. run build:sdk && cf dev",
    "build": "npm --prefix ../.. run build:sdk && cf build && node scripts/verifyNoTestSeam.mjs",
    "build:e2e": "npm --prefix ../.. run build:sdk && react-router build --mode e2e && node scripts/verifyNoTestSeam.mjs --expect-present",
    "start": "node scripts/startE2e.mjs",
    "typecheck": "npm --prefix ../.. run build:sdk && react-router typegen && tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.playwright.json --noEmit",
    "preview": "vite preview",
    "deploy": "node scripts/verifyNoTestSeam.mjs && cf deploy --prebuilt --mode production",
    "deploy:preview": "npm run build && cf previews deploy",
    "test": "npm --prefix ../.. run build:sdk && vitest run",
    "test:e2e": "npm --prefix ../.. run build:sdk && playwright test",
    "e2e": "npm --prefix ../.. run build:sdk && playwright test --grep-invert @a11y",
    "a11y": "npm --prefix ../.. run build:sdk && playwright test --grep @a11y",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium webkit",
    "catalogue:check": "npm --prefix ../.. run build:sdk && node --import tsx scripts/catalogueCheck.mjs",
    "capture:product": "tsx scripts/captureProduct.ts",
    "generate:og-image": "tsx scripts/generateOgImage.ts",
    "generate:og-sdk": "tsx scripts/generateSdkOgImage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "1.0.0-beta.32",
    "fontaine": "^1.0.3",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@mapcairn/adapter-maplibre": "0.1.0",
    "@mapcairn/core": "0.1.0",
    "@mapcairn/map": "0.1.0",
    "@mapcairn/react": "0.1.0",
    "@mapcairn/theme": "0.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vanilla-extract/css": "^1.21.3",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  }
}
