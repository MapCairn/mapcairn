{
  "name": "@mapcairn/react",
  "version": "0.2.0",
  "description": "Generic React hooks for MapCairn applications",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapCairn/mapcairn.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MapCairn/mapcairn/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/MapCairn/mapcairn/issues"
  },
  "keywords": [
    "mapcairn",
    "react",
    "hooks",
    "map",
    "webmcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@mapcairn/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.built"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/buildPackage.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
