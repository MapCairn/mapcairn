{
  "name": "@mapcairn/example-embed",
  "version": "1.0.0",
  "description": "A one-page app that embeds the MapCairn SDK through its public entry points",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../.. run build:sdk && vite",
    "build": "npm --prefix ../.. run build:sdk && vite build",
    "preview": "npm --prefix ../.. run build:sdk && vite preview",
    "test": "npm --prefix ../.. run build:sdk && vitest run",
    "typecheck": "npm --prefix ../.. run build:sdk && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@mapcairn/core": "0.2.0",
    "@mapcairn/map": "0.2.0",
    "@mapcairn/react": "0.2.0",
    "@mapcairn/theme": "0.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
