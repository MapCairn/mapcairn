{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapcairn",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./packages/web/workers/app.ts",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./packages/web/build/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "routes": [
    { "pattern": "karta.timothybrits.co.za", "custom_domain": true },
    { "pattern": "mapcairn.timothybrits.co.za", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build -w @mapcairn/web"
  }
}
