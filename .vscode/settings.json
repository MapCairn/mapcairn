{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.exclude": {
    "**/.wrangler": true,
    "**/.react-router": true,
    "**/build": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/*.tsbuildinfo": true
  },
  "search.exclude": {
    "**/package-lock.json": true,
    "**/.agents/skills": true,
    "**/.codex/agents": true,
    "**/.opencode/agents": true,
    "**/.qwen/agents": true,
    "**/.github/agents": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, tsconfig*.json, biome.json*, vite.config.*, vitest.config.*, playwright.config.*, react-router.config.*, wrangler.*, lefthook.yml, .dependency-cruiser.cjs, lighthouserc.json, .node-version, .npmrc",
    "README.md": "AGENTS.md, CLAUDE.md, ARCHITECTURE.md, DESIGN.md, ROADMAP.md, CONTRIBUTING.md, GOVERNANCE.md, CODE_OF_CONDUCT.md, CLA.md, SECURITY.md, PRIVACY.md, ATTRIBUTIONS.md, LICENSE*",
    ".gitignore": ".env*, .dev.vars*, .editorconfig, .gitattributes"
  }
}
